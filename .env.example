NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app,https://*.onrender.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=server-only-replace-me
CLAUDE_API_KEY=server-only-replace-me
AI_PROVIDER=claude
AI_MODEL=claude-3-5-haiku-latest
AI_MAX_OUTPUT_TOKENS=1200

# Email delivery (invitations + signup verification via POST /api/auth/resend-verification)
# EMAIL_PROVIDER=auto|smtp|resend  (default auto prefers SMTP, then Resend)
#
# Plug-and-play now (no domain): Gmail SMTP with an App Password
# 1) Google Account → Security → 2-Step Verification → App passwords
# 2) Fill the SMTP_* values below and set EMAIL_FROM to that Gmail address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=MARICS Security <you@gmail.com>
#
# Later, when you have a verified domain, switch to Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=MARICS Security <noreply@your-verified-domain.com>
RESEND_API_KEY=

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_URL=http://localhost:4000
